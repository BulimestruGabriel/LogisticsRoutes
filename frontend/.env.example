# Browser-accessible base URL of an OSRM-compatible driving router (without /route/v1/driving).
# The service must allow CORS from the frontend origin.
VITE_OSRM_BASE_URL=http://127.0.0.1:5000

# Minutes spent at each unfinished stop when estimating route completion (default: 5).
VITE_ETA_STOP_MINUTES=5

# Optional local delivery-day deadline in Europe/Chisinau, HH:mm (for example 18:00).
# Leave unset to hide the deadline warning.
# VITE_DELIVERY_CUTOFF_TIME=18:00
